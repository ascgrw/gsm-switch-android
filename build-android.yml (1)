name: Build GSM automatic SMS APK
on:
  push:
    paths: ['.github/workflows/build-android.yml']
  workflow_dispatch:
permissions:
  contents: read
jobs:
  apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'
      - name: Restore included Android source
        env:
          GSM_SOURCE_ZIP: 
        run: |
          python3 - <<'PY_SOURCE'
          import os, base64, hashlib, io, zipfile
          data = base64.b64decode(os.environ['GSM_SOURCE_ZIP'], validate=True)
          assert hashlib.sha256(data).hexdigest() == '6d703482f7521ca05f89a5ed949c35766f6c1220dcb1a9f21f5202004de3c5ef', 'Source checksum mismatch'
          with zipfile.ZipFile(io.BytesIO(data)) as archive:
              archive.extractall('source')
          PY_SOURCE
      - name: Install Android platform
        run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'
      - name: Test command protocol
        working-directory: source/GSM-Automatic-SMS-Android
        run: |
          mkdir -p build/protocol-tests
          javac -d build/protocol-tests app/src/main/java/com/shahid/gsmcontrol/Protocol.java tests/ProtocolTest.java
          java -cp build/protocol-tests com.shahid.gsmcontrol.ProtocolTest
      - name: Build installable debug APK
        working-directory: source/GSM-Automatic-SMS-Android
        run: |
          gradle --no-daemon assembleDebug
          cp app/build/outputs/apk/debug/app-debug.apk GSM-Switch-AutoSMS-debug.apk
      - uses: actions/upload-artifact@v4
        with:
          name: GSM-Switch-AutoSMS-APK
          path: source/GSM-Automatic-SMS-Android/GSM-Switch-AutoSMS-debug.apk
          if-no-files-found: error
